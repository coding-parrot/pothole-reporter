# Copy this file to keystore.properties (which is gitignored), replace every
# value, and restrict it with: chmod 600 keystore.properties
# Keep the upload keystore outside the repository. Relative storeFile paths are
# resolved from android-app/android.
storeFile=/absolute/path/to/upload-key.jks
storePassword=replace-me
keyAlias=upload
keyPassword=replace-me
