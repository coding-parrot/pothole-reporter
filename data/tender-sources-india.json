{
  "registry_id": "india-road-civil-tender-sources",
  "schema_version": 1,
  "as_of": "2026-08-26",
  "scope": "Primary official procurement sources for road and civil works in all 28 Indian states, all 8 union territories, and selected central road agencies.",
  "coverage_warning": "A statewide procurement portal is not proof that every municipal body, development authority, state PSU, or road-owning agency publishes there. Agency-specific portals and official work-management systems may still be required.",
  "field_status_values": {
    "structured": "A labelled portal field or stable table column.",
    "semi_structured": "A labelled field whose values are not normalized across publishers.",
    "unstructured_text": "Normally present only in a title or free-text description.",
    "unstructured_document": "Must be extracted from an official tender, AOC, agreement, work-order, or maintenance document.",
    "conditional_aoc": "Available only when the purchasing authority publishes and completes an AOC or award record.",
    "conditional_document": "Available only when the authority uploads the relevant official document.",
    "not_available": "The reviewed public source does not expose this field.",
    "not_applicable": "The source is not intended to hold this field."
  },
  "match_semantics": {
    "tender_candidate": {
      "status": "candidate",
      "meaning": "An official tender may concern the area and a road-relevant scope, but responsibility for the reported road point has not been proved.",
      "minimum_evidence": [
        "official source URL",
        "tender ID or reference",
        "verbatim work title",
        "road-relevant scope after excluding drain-only, footpath-only, utility-only, and unrelated civil works"
      ],
      "must_not_claim": [
        "that the tender covers the exact road segment",
        "that a named bidder won without an official award or work order",
        "that a warranty or DLP is active",
        "that publication date proves contractor responsibility"
      ]
    },
    "verified_contract_match": {
      "status": "verified",
      "meaning": "The official evidence links the reported road point, qualifying road-work scope, awarded contractor, and active responsibility period.",
      "required_evidence": [
        "official tender ID or reference and immutable source document or URL",
        "road name, road identifier, chainage, package geometry, or other evidence placing the report coordinate inside the contracted segment",
        "scope includes carriageway, pavement, resurfacing, repair, rehabilitation, or road maintenance rather than only drain, footpath, utility, landscaping, or unrelated civil work",
        "official AOC, LoA, agreement, or work order identifies the awarded contractor",
        "contract commencement, completion, maintenance, or DLP evidence proves responsibility was active on the report date",
        "road owner or responsible authority is consistent with the contract"
      ]
    },
    "publication_date_rule": "Tender or award publication dates alone must never be used to infer an active DLP, warranty, road ownership, or present contractor responsibility."
  },
