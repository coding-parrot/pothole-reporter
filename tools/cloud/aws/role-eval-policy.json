{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "Logs", "Effect": "Allow",
     "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
     "Resource": ["arn:aws:logs:ap-south-1:695656921622:log-group:/aws/codebuild/pothole-reporter-ci",
                  "arn:aws:logs:ap-south-1:695656921622:log-group:/aws/codebuild/pothole-reporter-ci:*"]},
    {"Sid": "ReadLabelledFrames", "Effect": "Allow", "Action": "s3:GetObject",
     "Resource": ["arn:aws:s3:::pothole-reporter-ml-695656921622-ap-south-1/v1-work/manifest.jsonl",
                  "arn:aws:s3:::pothole-reporter-ml-695656921622-ap-south-1/v1-work/frames/*"]},
    {"Sid": "EvalPrefixObjects", "Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject"],
     "Resource": "arn:aws:s3:::pothole-reporter-ml-695656921622-ap-south-1/evals/*"},
    {"Sid": "DetectorKey", "Effect": "Allow", "Action": "secretsmanager:GetSecretValue",
     "Resource": "arn:aws:secretsmanager:ap-south-1:695656921622:secret:pothole-reporter-central/detector-G2AzBg"}
  ]
}
